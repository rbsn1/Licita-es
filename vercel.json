{
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "includeFiles": "src/**",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/cron/prospectar", "schedule": "0 6 * * *" },
    { "path": "/cron/analisar", "schedule": "15 6 * * *" }
  ]
}
